{
  "name": "vcc-directory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles.input.css -o ./src/styles.css --minify",
    "dev": "npm run build:css && wrangler dev",
    "deploy": "npm run build:css && wrangler deploy --minify",
    "check": "npm run build:css && tsc --noEmit && vitest run",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:init": "wrangler d1 execute vcc-db --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute vcc-db --remote --file=./schema.sql",
    "db:migrate": "wrangler d1 migrations apply vcc-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vcc-db --remote"
  },
  "dependencies": {
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
